                   self.__type = self.Image
                   self.__imageData = ImageData()
                   self.__imageData.rect = rect
                   self.__imageData.image = image
                   self.__imageData.subRect = subRect
                   self.__imageData.flags = flags
               else:
                   raise TypeError(
                       "%s() takes 0, 1, 3 or 4 argument(s) (%s given)"
