    1:     def gethomedir(self, username):
               if not username:
                   try:
                       return os.environ['HOME']
                   except KeyError:
                       import pwd
                       return pwd.getpwuid(os.getuid()).pw_dir
               else:
                   import pwd
                   try:
                       return pwd.getpwnam(username).pw_dir
                   except KeyError:
                       raise RuntimeError("Can't determine home directory "
                                          "for %r" % username)
       
       
