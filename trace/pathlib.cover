               third = part[2:3]
               if (second == sep and first == sep and third != sep):
                   # is a UNC path:
                   # vvvvvvvvvvvvvvvvvvvvv root
                   # \\machine\mountpoint\directory\etc\...
                   #            directory ^^^^^^^^^^^^^^
