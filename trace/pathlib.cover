                   try:
                       successor_select = self.successor._select_from
                       for starting_point in self._iterate_directories(parent_path, is_dir, scandir):
                           for p in successor_select(starting_point, is_dir, exists, scandir):
                               if p not in yielded:
                                   yield p
                                   yielded.add(p)
                   finally:
                       yielded.clear()
