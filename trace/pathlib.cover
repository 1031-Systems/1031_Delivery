                   parent_dev = self.parent.stat().st_dev
               except OSError:
                   return False
       
               dev = self.stat().st_dev
               if dev != parent_dev:
                   return True
               ino = self.stat().st_ino
               parent_ino = self.parent.stat().st_ino
               return ino == parent_ino
       
