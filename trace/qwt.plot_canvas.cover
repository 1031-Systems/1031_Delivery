                           bgWidget, pm, widget.mapTo(bgWidget, rect.topLeft())
                       )
                       painter.drawPixmap(rect, pm)
       
           else:
               raise TypeError(
                   "%s() takes 2 or 3 argument(s) (%s given)"
                   % ("qwtFillBackground", len(args))
               )
       
       
