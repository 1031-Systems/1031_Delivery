    1:     def setLayoutFlag(self, flag, on=True):
               """
               Toggle an layout flag
       
               :param int flag: Layout flag
               :param bool on: True/False
       
               .. seealso::
       
                   :py:meth:`testLayoutFlag()`
               """
               if (self.__data.layoutFlags & flag != 0) != on:
                   if on:
                       self.__data.layoutFlags |= flag
                   else:
                       self.__data.layoutFlags &= ~flag
               self.update()
       
