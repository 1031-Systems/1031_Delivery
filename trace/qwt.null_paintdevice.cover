    2: class QwtNullPaintDevice(QPaintDevice):
    1:     """
           A null paint device doing nothing
       
           Sometimes important layout/rendering geometries are not
           available or changeable from the public Qt class interface.
           ( f.e hidden in the style implementation ).
       
           `QwtNullPaintDevice` can be used to manipulate or filter out
           this information by analyzing the stream of paint primitives.
       
           F.e. `QwtNullPaintDevice` is used by `QwtPlotCanvas` to identify
           styled backgrounds with rounded corners.
       
           Modes:
       
               * `NormalMode`:
       
                  All vector graphic primitives are painted by
                  the corresponding draw methods
       
               * `PolygonPathMode`:
       
                  Vector graphic primitives ( beside polygons ) are mapped to a
                  `QPainterPath` and are painted by `drawPath`. In `PolygonPathMode`
                  mode only a few draw methods are called:
       
                      - `drawPath()`
                      - `drawPixmap()`
                      - `drawImage()`
                      - `drawPolygon()`
       
               * `PathMode`:
       
                  Vector graphic primitives are mapped to a `QPainterPath`
                  and are painted by `drawPath`. In `PathMode` mode
                  only a few draw methods are called:
       
                      - `drawPath()`
                      - `drawPixmap()`
                      - `drawImage()`
           """
       
           # enum Mode
    1:     NormalMode, PolygonPathMode, PathMode = list(range(3))
       
    1:     def __init__(self):
   85:         super(QwtNullPaintDevice, self).__init__()
   85:         self.__engine = None
   85:         self.__data = QwtNullPaintDevice_PrivateData()
       
    1:     def setMode(self, mode):
               """
               Set the render mode
       
               :param int mode: New mode
       
               .. seealso::
       
                   :py:meth:`mode()`
               """
   85:         self.__data.mode = mode
       
    1:     def mode(self):
               """
               :return: Render mode
       
               .. seealso::
       
                   :py:meth:`setMode()`
               """
  106:         return self.__data.mode
       
    1:     def paintEngine(self):
  159:         if self.__engine is None:
   53:             self.__engine = QwtNullPaintDevice_PaintEngine(self)
  159:         return self.__engine
       
    1:     def metric(self, deviceMetric):
  212:         if deviceMetric == QPaintDevice.PdmWidth:
   53:             value = self.sizeMetrics().width()
  159:         elif deviceMetric == QPaintDevice.PdmHeight:
   53:             value = self.sizeMetrics().height()
  106:         elif deviceMetric == QPaintDevice.PdmNumColors:
                   value = 0xFFFFFFFF
  106:         elif deviceMetric == QPaintDevice.PdmDepth:
                   value = 32
  212:         elif deviceMetric in (
  106:             QPaintDevice.PdmPhysicalDpiX,
  106:             QPaintDevice.PdmPhysicalDpiY,
  106:             QPaintDevice.PdmDpiY,
  106:             QPaintDevice.PdmDpiX,
               ):
   53:             value = 72
   53:         elif deviceMetric == QPaintDevice.PdmWidthMM:
                   value = round(
                       self.metric(QPaintDevice.PdmWidth)
                       * 25.4
                       / self.metric(QPaintDevice.PdmDpiX)
                   )
   53:         elif deviceMetric == QPaintDevice.PdmHeightMM:
                   value = round(
                       self.metric(QPaintDevice.PdmHeight)
                       * 25.4
                       / self.metric(QPaintDevice.PdmDpiY)
                   )
               else:
   53:             value = 0
  212:         return value
       
