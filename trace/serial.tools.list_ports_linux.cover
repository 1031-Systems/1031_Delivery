    1: from __future__ import absolute_import
       
    1: import glob
    1: import os
    1: from serial.tools import list_ports_common
       
       
    2: class SysFS(list_ports_common.ListPortInfo):
    1:     """Wrapper for easy sysfs access and device info"""
       
    1:     def __init__(self, device):
  772:         super(SysFS, self).__init__(device)
               # special handling for links
  772:         if device is not None and os.path.islink(device):
                   device = os.path.realpath(device)
                   is_link = True
               else:
  772:             is_link = False
  772:         self.usb_device_path = None
  772:         if os.path.exists('/sys/class/tty/{}/device'.format(self.name)):
  772:             self.device_path = os.path.realpath('/sys/class/tty/{}/device'.format(self.name))
  772:             self.subsystem = os.path.basename(os.path.realpath(os.path.join(self.device_path, 'subsystem')))
               else:
                   self.device_path = None
                   self.subsystem = None
               # check device type
  772:         if self.subsystem == 'usb-serial':
                   self.usb_interface_path = os.path.dirname(self.device_path)
  772:         elif self.subsystem == 'usb':
                   self.usb_interface_path = self.device_path
               else:
  772:             self.usb_interface_path = None
               # fill-in info for USB devices
  772:         if self.usb_interface_path is not None:
                   self.usb_device_path = os.path.dirname(self.usb_interface_path)
       
                   try:
                       num_if = int(self.read_line(self.usb_device_path, 'bNumInterfaces'))
                   except ValueError:
                       num_if = 1
       
                   self.vid = int(self.read_line(self.usb_device_path, 'idVendor'), 16)
                   self.pid = int(self.read_line(self.usb_device_path, 'idProduct'), 16)
                   self.serial_number = self.read_line(self.usb_device_path, 'serial')
                   if num_if > 1:  # multi interface devices like FT4232
                       self.location = os.path.basename(self.usb_interface_path)
                   else:
                       self.location = os.path.basename(self.usb_device_path)
       
                   self.manufacturer = self.read_line(self.usb_device_path, 'manufacturer')
                   self.product = self.read_line(self.usb_device_path, 'product')
                   self.interface = self.read_line(self.usb_interface_path, 'interface')
       
  772:         if self.subsystem in ('usb', 'usb-serial'):
                   self.apply_usb_info()
               #~ elif self.subsystem in ('pnp', 'amba'):  # PCI based devices, raspi
  772:         elif self.subsystem == 'pnp':  # PCI based devices
                   self.description = self.name
                   self.hwid = self.read_line(self.device_path, 'id')
  772:         elif self.subsystem == 'amba':  # raspi
                   self.description = self.name
                   self.hwid = os.path.basename(self.device_path)
       
  772:         if is_link:
                   self.hwid += ' LINK={}'.format(device)
       
    1:     def read_line(self, *args):
               """\
               Helper function to read a single line from a file.
               One or more parameters are allowed, they are joined with os.path.join.
               Returns None on errors..
               """
               try:
                   with open(os.path.join(*args)) as f:
                       line = f.readline().strip()
                   return line
               except IOError:
                   return None
       
       
    1: def comports(include_links=False):
  193:     devices = glob.glob('/dev/ttyS*')           # built-in serial ports
  193:     devices.extend(glob.glob('/dev/ttyUSB*'))   # usb-serial with own driver
  193:     devices.extend(glob.glob('/dev/ttyXRUSB*')) # xr-usb-serial port exar (DELL Edge 3001)
  193:     devices.extend(glob.glob('/dev/ttyACM*'))   # usb-serial with CDC-ACM profile
  193:     devices.extend(glob.glob('/dev/ttyAMA*'))   # ARM internal port (raspi)
  193:     devices.extend(glob.glob('/dev/rfcomm*'))   # BT serial devices
  193:     devices.extend(glob.glob('/dev/ttyAP*'))    # Advantech multi-port serial controllers
  193:     if include_links:
               devices.extend(list_ports_common.list_links(devices))
 1351:     return [info
 1930:             for info in [SysFS(d) for d in devices]
  772:             if info.subsystem != "platform"]    # hide non-present internal serial ports
       
       # - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
       # test
    1: if __name__ == '__main__':
           for info in sorted(comports()):
               print("{0}: {0.subsystem}".format(info))
