       def _parse_flags(source, state, char):
    7:     sourceget = source.get
    7:     add_flags = 0
    7:     del_flags = 0
    7:     if char != "-":
               while True:
    7:             flag = FLAGS[char]
    7:             if source.istext:
    7:                 if char == 'L':
                           msg = "bad inline flags: cannot use 'L' flag with a str pattern"
                           raise source.error(msg)
                   else:
