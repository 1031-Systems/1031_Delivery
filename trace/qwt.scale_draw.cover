 5009:         pos = self.labelPosition(value)
 5009:         transform = self.labelTransformation(pos, labelSize)
 5009:         br = transform.mapRect(QRectF(QPointF(0, 0), labelSize))
 5009:         br.translate(-pos.x(), -pos.y())
 5009:         return br
       
