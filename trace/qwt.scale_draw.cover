    1:         Qt.AlignHCenter | Qt.AlignBottom,  # BottomScale
    1:         Qt.AlignHCenter | Qt.AlignTop,  # TopScale
    1:         Qt.AlignLeft | Qt.AlignVCenter,  # LeftScale
    1:         Qt.AlignRight | Qt.AlignVCenter,  # RightScale
           )
       
